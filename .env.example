# 로컬 접속 주소와 정확하게 일치시킵니다. 끝에 /를 붙이지 않습니다.
APP_ORIGIN=http://127.0.0.1:8000

# Supabase Connect에서 복사한 PostgreSQL URI를 입력하세요.
# IPv4 환경에서는 Session pooler 연결 문자열을 사용할 수 있습니다.
# 비밀번호에 특수문자가 있으면 URI의 비밀번호 부분을 URL 인코딩하세요.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# 직접 PostgreSQL로 연결하므로 STEP 2에서 아래 두 값은 사용하지 않습니다.
# Supabase 프로젝트 정보가 필요할 경우에도 .env에서만 관리합니다.
SUPABASE_URL=
SUPABASE_KEY=

# 사용자 실행: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 출력된 무작위 값으로 바꿔야 시작됩니다. 저장소에 커밋하지 마세요.
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

ACCESS_TOKEN_EXPIRE_MINUTES=60
# 로컬 HTTP는 false, HTTPS로 배포할 때는 true로 설정합니다.
COOKIE_SECURE=false
