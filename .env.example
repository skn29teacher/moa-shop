# Local Flask origin; no trailing slash. Keep 127.0.0.1 and localhost consistent.
APP_ORIGIN=http://127.0.0.1:8000

# Supabase test project PostgreSQL URI (Session pooler for IPv4 if needed).
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Same project's HTTPS URL and publishable key (or legacy anon key).
# Do not use a service_role or secret key. No Auth admin key is needed.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Encrypts server-side Supabase tokens. Generate once and keep stable:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Absolute app session lifetime. Access JWT expiry is managed by Supabase.
SESSION_DAYS=7
# Local HTTP: false. HTTPS deployment: true.
COOKIE_SECURE=false
