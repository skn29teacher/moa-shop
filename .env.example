# Local origin; no trailing slash. Use the same hostname in the browser.
APP_ORIGIN=http://127.0.0.1:8000

# SQLite file. Relative paths are resolved against the project directory, not shell cwd.
# The application initializes a new file without dropping existing data.
DATABASE_PATH=instance/shop.sqlite3

# Supabase is used ONLY for Auth over HTTPS. No PostgreSQL URI is required.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Encrypts server-side Auth tokens. Generate once, then keep stable:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
SESSION_DAYS=7
# Local HTTP: false. HTTPS deployment: true.
COOKIE_SECURE=false

# Groq chat is optional. Keep real keys only in the server .env, never in browser JS.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=25
GROQ_MAX_COMPLETION_TOKENS=1024
# Shared by visitors per worker; resets on restart (demo limits, not billing limits).
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100
